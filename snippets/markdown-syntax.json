{
  "Heading 0 · Document title": {
    "kind": "Markdown",
    "prefix": ["heading0", "head0", "h0"],
    "description": "H0 兼容别名；Markdown 中按一级文档标题输出",
    "body": ["# ${1:Document title}", "", "${0}"]
  },
  "Heading 1": {
    "kind": "Markdown",
    "prefix": ["heading1", "head1", "h1"],
    "description": "插入一级标题",
    "body": ["# ${1:Heading 1}", "", "${0}"]
  },
  "Heading 2": {
    "kind": "Markdown",
    "prefix": ["heading2", "head2", "h2"],
    "description": "插入二级标题",
    "body": ["## ${1:Heading 2}", "", "${0}"]
  },
  "Heading 3": {
    "kind": "Markdown",
    "prefix": ["heading3", "head3", "h3"],
    "description": "插入三级标题",
    "body": ["### ${1:Heading 3}", "", "${0}"]
  },
  "Heading 4": {
    "kind": "Markdown",
    "prefix": ["heading4", "head4", "h4"],
    "description": "插入四级标题",
    "body": ["#### ${1:Heading 4}", "", "${0}"]
  },
  "Heading 5": {
    "kind": "Markdown",
    "prefix": ["heading5", "head5", "h5"],
    "description": "插入五级标题",
    "body": ["##### ${1:Heading 5}", "", "${0}"]
  },
  "Heading 6": {
    "kind": "Markdown",
    "prefix": ["heading6", "head6", "h6"],
    "description": "插入六级标题",
    "body": ["###### ${1:Heading 6}", "", "${0}"]
  },
  "Bold text": {
    "kind": "Markdown",
    "prefix": ["bold", "strong"],
    "description": "插入粗体文本",
    "body": "**${1:text}**${0}"
  },
  "Italic text": {
    "kind": "Markdown",
    "prefix": ["italic", "em"],
    "description": "插入斜体文本",
    "body": "*${1:text}*${0}"
  },
  "Bold italic text": {
    "kind": "Markdown",
    "prefix": ["bolditalic", "strongem"],
    "description": "插入粗斜体文本",
    "body": "***${1:text}***${0}"
  },
  "Strikethrough text": {
    "kind": "Markdown",
    "prefix": ["strike", "delete"],
    "description": "插入删除线文本",
    "body": "~~${1:text}~~${0}"
  },
  "Link": {
    "kind": "Markdown",
    "prefix": ["link", "url"],
    "description": "插入 Markdown 链接",
    "body": "[${1:text}](${2:url})${0}"
  },
  "Image": {
    "kind": "Markdown",
    "prefix": ["image", "img"],
    "description": "插入 Markdown 图片",
    "body": "![${1:alt}](${2:path})${0}"
  },
  "Block quote": {
    "kind": "Markdown",
    "prefix": ["quote", "blockquote"],
    "description": "插入引用块",
    "body": ["> ${1:quote}", "", "${0}"]
  },
  "Task list": {
    "kind": "Markdown",
    "prefix": ["task", "todo"],
    "description": "插入任务列表",
    "body": ["- [ ] ${1:task}", "${0}"]
  },
  "Unordered list": {
    "kind": "Markdown",
    "prefix": ["unordered", "ul", "bullet"],
    "description": "插入无序列表",
    "body": ["- ${1:item}", "- ${2:item}", "${0}"]
  },
  "Ordered list": {
    "kind": "Markdown",
    "prefix": ["ordered", "ol", "numbered"],
    "description": "插入有序列表",
    "body": ["1. ${1:item}", "2. ${2:item}", "${0}"]
  },
  "Inline code": {
    "kind": "Markdown",
    "prefix": ["inlinecode", "icode"],
    "description": "插入行内代码",
    "body": "`${1:code}`${0}"
  },
  "Inline math": {
    "kind": "Markdown",
    "prefix": ["inlinemath", "imath"],
    "description": "插入行内 LaTeX 公式",
    "body": "$${1:formula}$${0}"
  },
  "Horizontal rule": {
    "kind": "Markdown",
    "prefix": ["rule", "hr"],
    "description": "插入分隔线",
    "body": ["---", "", "${0}"]
  }
}
